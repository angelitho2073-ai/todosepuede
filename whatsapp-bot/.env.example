# --- Claude (Anthropic) ---
# Crea tu clave en https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5

# --- WhatsApp Business (Meta Cloud API) ---
WHATSAPP_TOKEN=EAAG...                # Token de acceso permanente (usuario del sistema)
WHATSAPP_PHONE_NUMBER_ID=123456789012 # "Identificador del número de teléfono"
WHATSAPP_VERIFY_TOKEN=elige-una-palabra-secreta   # la misma que pondrás en Meta al configurar el webhook
WHATSAPP_APP_SECRET=                  # "Clave secreta de la app" (recomendado: valida que los mensajes vengan de Meta)

# --- Panel ---
ADMIN_TOKEN=cambia-esto-por-una-clave-larga
OWNER_PHONE=51999999999               # Tu número personal (con código de país) para recibir avisos

# --- Comportamiento ---
REQUIERE_PAGO=true    # true = el trabajo empieza cuando confirmas el pago en el panel
AUTO_ENTREGA=false    # true = se entrega sin tu revisión (no recomendado)
AGRUPAR_MS=4000       # espera para juntar mensajes seguidos del cliente
TZ=America/Lima
PORT=3000
